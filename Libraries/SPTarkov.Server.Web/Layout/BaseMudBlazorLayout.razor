@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<MudThemeProvider Theme="@_theme" IsDarkMode=true />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<main>
@if (!IsLandingPage)
{
    <MudTooltip Text="Return to landing page" Placement="Placement.Right">
        <MudIconButton Icon="@Icons.Material.Filled.Home"
                       Href="/"
                       Variant="Variant.Outlined"
                       Color="Color.Warning"
                       Size="Size.Medium"
                       Class="spt-home-button"
                       OnClick="Collect"
                       AriaLabel="Return to landing page" />
    </MudTooltip>
}

@Body
</main>

@code {
    private bool IsLandingPage
    {
        get
        {
            var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Trim('/');
            return string.IsNullOrWhiteSpace(relativePath);
        }
    }

    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#38bdf8",
            Secondary = "#f59e0b",
            Warning = "#facc15",
            Info = "#22d3ee",
            Success = "#34d399",
            Background = "#030712",
            Surface = "#18181b",
            AppbarBackground = "#030712",
            TextPrimary = "#f8fafc",
            TextSecondary = "#a1a1aa",
            Divider = "#27272a",
            LinesDefault = "#27272a",
            TableLines = "#27272a",
            TableStriped = "rgba(39,39,42,0.35)",
            TableHover = "rgba(56,189,248,0.08)"
        }
    };

    private static void Collect(MouseEventArgs obj)
    {
        GC.Collect();
    }
}
