@if (Visible || !string.IsNullOrWhiteSpace(Error))
{
    <div class="database-loading-overlay" role="status" aria-live="polite">
        <MudPaper Elevation="0" Class="database-loading-panel spt-panel pa-6">
            @if (string.IsNullOrWhiteSpace(Error))
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Large" Color="Color.Warning" />
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" />
            }
            <MudStack Spacing="1" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6">@Title</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                    @Message
                </MudText>
            </MudStack>
        </MudPaper>
    </div>
}

@code {
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public string LoadingTitle { get; set; } = "Loading database browser";

    [Parameter]
    public string LoadingMessage { get; set; } = "Preparing tables.";

    [Parameter]
    public string ErrorTitle { get; set; } = "Database browser failed to load";

    private string Title
    {
        get { return string.IsNullOrWhiteSpace(Error) ? LoadingTitle : ErrorTitle; }
    }

    private string Message
    {
        get { return string.IsNullOrWhiteSpace(Error) ? LoadingMessage : Error; }
    }
}
