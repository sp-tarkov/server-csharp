@using SPTarkov.Server.Web.Models.Database

@if (Open)
{
    <div class="database-assort-modal-backdrop" @onclick="OnClose">
        <div class="database-assort-modal" role="dialog" aria-modal="true" @onclick:stopPropagation>
            @if (Loading || Assort is null)
            {
                <MudPaper Elevation="0" Class="database-assort-loading spt-panel pa-6">
                    <MudProgressCircular Indeterminate="true" Size="Size.Large" Color="Color.Warning" />
                    <MudStack Spacing="1" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h6">Loading trader assort</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">@LoadingMessage</MudText>
                    </MudStack>
                </MudPaper>
            }
            else
            {
                <DatabaseTraderAssortBrowser Assort="Assort" OnClose="OnClose" />
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public DatabaseTraderAssort? Assort { get; set; }

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public string LoadingMessage { get; set; } = "Preparing assort items.";

    [Parameter]
    public EventCallback OnClose { get; set; }
}
