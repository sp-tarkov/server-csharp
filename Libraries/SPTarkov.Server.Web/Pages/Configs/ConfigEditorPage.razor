@page "/configs"
@attribute [Authorize(Policy = "Administrator")]
@using SPTarkov.Server.Web.Components.Configs
@using SPTarkov.Server.Web.Components.Database
@using SPTarkov.Server.Web.Layout
@using SPTarkov.Server.Web.Models.Configs
@using SPTarkov.Server.Web.Services
@inject ConfigEditorService ConfigEditorService
@inject ISnackbar Snackbar
@inject WebLocalizationService WebLocalizationService

@layout BaseMudBlazorLayout

<PageTitle>@L("configs-page-title")</PageTitle>

<div class="config-editor-page spt-page">
    <DatabaseLoadingOverlay Visible="@IsLoadingOverlayVisible"
                            Error="@_loadError"
                            LoadingTitle="@_loadingTitle"
                            LoadingMessage="@_loadingMessage"
                            ErrorTitle="@L("configs-load-failed")" />

    <MudContainer MaxWidth="MaxWidth.False" Class="config-editor-container pa-6">
        <MudStack Spacing="4">
            <MudPaper Elevation="0" Class="config-editor-header spt-panel pa-5">
                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="config-editor-header-content">
                    <MudStack Spacing="1">
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="3" Class="config-editor-title-row">
                            <MudIcon Icon="@Icons.Material.Filled.Tune" Color="Color.Warning" Size="Size.Large" />
                            <MudText Typo="Typo.h3">@L("configs-heading")</MudText>
                        </MudStack>
                        <MudText Typo="Typo.body2">@L("configs-subtitle")</MudText>
                    </MudStack>

                    <MudStack Row Spacing="2" Class="config-editor-stat-stack">
                        <MudPaper Elevation="0" Class="config-editor-stat spt-panel pa-3">
                            <MudText Typo="Typo.caption">@L("configs-count-label")</MudText>
                            <MudText Typo="Typo.h5">@_configs.Count.ToString("N0")</MudText>
                        </MudPaper>
                        <MudPaper Elevation="0" Class="config-editor-stat spt-panel pa-3">
                            <MudText Typo="Typo.caption">@L("configs-runtime-diffs")</MudText>
                            <MudText Typo="Typo.h5">@_configs.Count(config => config.ModifiedByMods).ToString("N0")</MudText>
                        </MudPaper>
                        <MudPaper Elevation="0" Class="config-editor-stat spt-panel pa-3">
                            <MudText Typo="Typo.caption">@L("configs-presets")</MudText>
                            <MudText Typo="Typo.h5">@_presetCount.ToString("N0")</MudText>
                        </MudPaper>
                    </MudStack>
                </MudStack>
            </MudPaper>

            @if (!string.IsNullOrWhiteSpace(_loadError))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_loadError</MudAlert>
            }
            else if (!_isLoading)
            {
                <div class="config-editor-grid">
                    <MudPaper Elevation="0" Class="config-editor-sidebar spt-panel pa-4">
                        <MudStack Spacing="3">
                            <MudText Typo="Typo.h6">@ConfigListTitle</MudText>

                            <div class="config-editor-source-toggle" role="tablist" aria-label="@L("configs-source")">
                                <button type="button"
                                        class="@GetConfigSourceButtonClass(ConfigEditorConfigSource.Server)"
                                        aria-selected="@(_selectedConfigSource == ConfigEditorConfigSource.Server)"
                                        disabled="@_isWorking"
                                        @onclick="() => SelectConfigSource(ConfigEditorConfigSource.Server)">
                                    <span>@L("configs-server")</span>
                                    <span>@ServerConfigCount.ToString("N0")</span>
                                </button>
                                <button type="button"
                                        class="@GetConfigSourceButtonClass(ConfigEditorConfigSource.Mod)"
                                        aria-selected="@(_selectedConfigSource == ConfigEditorConfigSource.Mod)"
                                        disabled="@_isWorking"
                                        @onclick="() => SelectConfigSource(ConfigEditorConfigSource.Mod)">
                                    <span>@L("configs-mods")</span>
                                    <span>@ModConfigCount.ToString("N0")</span>
                                </button>
                            </div>

                            <MudTextField T="string"
                                          Label="@L("configs-filter")"
                                          Variant="Variant.Outlined"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          Immediate="true"
                                          @bind-Value="_searchText" />

                            <div class="config-editor-config-list">
                                @if (FilteredConfigs.Count == 0)
                                {
                                    <MudPaper Elevation="0" Class="config-editor-empty-list pa-4">
                                        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="1">
                                            <MudIcon Icon="@Icons.Material.Filled.FolderOff" Color="Color.Warning" Size="Size.Medium" />
                                            <MudText Typo="Typo.subtitle2">@L("common-no") @(ConfigListTitle.ToLowerInvariant())</MudText>
                                        </MudStack>
                                    </MudPaper>
                                }
                                else
                                {
                                    <Virtualize Items="@FilteredConfigs" Context="config" ItemSize="66" OverscanCount="8">
                                        <button type="button"
                                                class="@GetConfigButtonClass(config)"
                                                @key="config.Id"
                                                @onclick="() => SelectConfig(config.Id)">
                                            <span class="config-editor-config-main">
                                                <span class="config-editor-config-title">@config.DisplayName</span>
                                                <span class="config-editor-config-file">@config.FileName</span>
                                            </span>
                                            @if (config.ModifiedByMods)
                                            {
                                                <MudTooltip Text="@L("configs-runtime-diff-tooltip")">
                                                    <MudIcon Icon="@Icons.Material.Filled.Extension" Color="Color.Warning" Size="Size.Small" />
                                                </MudTooltip>
                                            }
                                        </button>
                                    </Virtualize>
                                }
                            </div>
                        </MudStack>
                    </MudPaper>

                    <MudPaper Elevation="0" Class="config-editor-main spt-panel pa-4">
                        <MudStack Spacing="3" Class="config-editor-main-stack">
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="config-editor-toolbar">
                                <MudStack Spacing="1">
                                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="config-editor-heading-row">
                                        <MudText Typo="Typo.h5">@SelectedConfig?.DisplayName</MudText>
                                        @if (SelectedConfig?.IsRegisteredConfig == true)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info">@L("configs-registered")</MudChip>
                                        }
                                        @if (_snapshot?.ModifiedByMods == true)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">@L("configs-runtime-diff-chip")</MudChip>
                                        }
                                        @if (EditorModified)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info">@L("configs-editor-modified")</MudChip>
                                        }
                                    </MudStack>
                                    <MudText Typo="Typo.caption">@_sourceLabel</MudText>
                                </MudStack>

                                <MudStack Row Spacing="2" Class="config-editor-actions">
                                    <MudTooltip Text="@L("configs-load-current-di")">
                                        <MudIconButton Variant="Variant.Outlined"
                                                   Color="Color.Secondary"
                                                   Icon="@Icons.Material.Filled.Memory"
                                                   Disabled="@_isWorking"
                                                   aria-label="@L("configs-load-current-di")"
                                                   OnClick="LoadCurrentServer">
                                        </MudIconButton>
                                    </MudTooltip>
                                    <MudTooltip Text="@L("configs-load-clean-disk")">
                                        <MudIconButton Variant="Variant.Outlined"
                                                   Color="Color.Secondary"
                                                   Icon="@Icons.Material.Filled.FolderOpen"
                                                   Disabled="@_isWorking"
                                                   aria-label="@L("configs-load-clean-disk")"
                                                   OnClick="LoadCleanFromDisk">
                                        </MudIconButton>
                                    </MudTooltip>
                                    <MudTooltip Text="@L("configs-format-json")">
                                        <MudIconButton Icon="@Icons.Material.Filled.FormatAlignLeft"
                                                       Variant="Variant.Outlined"
                                                       Color="Color.Secondary"
                                                       Disabled="@_isWorking"
                                                       aria-label="@L("configs-format-json")"
                                                       OnClick="FormatEditor"/>
                                    </MudTooltip>
                                    <MudTooltip Text="@L("configs-validate-json")">
                                        <MudIconButton Icon="@Icons.Material.Filled.Rule"
                                                       Variant="Variant.Outlined"
                                                       Color="Color.Secondary"
                                                       Disabled="@_isWorking"
                                                       aria-label="@L("configs-validate-json")"
                                                       OnClick="ValidateEditor"/>
                                    </MudTooltip>
                                </MudStack>
                            </MudStack>

                            @if (_snapshot?.ModifiedByMods == true)
                            {
                                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                                    @L("configs-runtime-values-differ")
                                </MudAlert>
                            }

                            <div class="config-editor-meta-grid">
                                <MudPaper Elevation="0" Class="config-editor-meta spt-panel pa-3">
                                    <MudText Typo="Typo.caption">@L("configs-runtime-size")</MudText>
                                    <MudText Typo="Typo.subtitle2">@((SelectedConfig?.RuntimeCharacterCount ?? 0).ToString("N0")) @L("configs-chars")</MudText>
                                </MudPaper>
                                <MudPaper Elevation="0" Class="config-editor-meta spt-panel pa-3">
                                    <MudText Typo="Typo.caption">@L("configs-disk-size")</MudText>
                                    <MudText Typo="Typo.subtitle2">@((SelectedConfig?.CleanCharacterCount ?? 0).ToString("N0")) @L("configs-chars")</MudText>
                                </MudPaper>
                                <MudPaper Elevation="0" Class="config-editor-meta spt-panel pa-3">
                                    <MudText Typo="Typo.caption">@L("configs-top-level-props")</MudText>
                                    <MudText Typo="Typo.subtitle2">@((SelectedConfig?.TopLevelPropertyCount ?? 0).ToString("N0"))</MudText>
                                </MudPaper>
                            </div>

                            <MudPaper Elevation="0" Class="config-editor-tabs-panel spt-panel">
                                <MudTabs Class="config-editor-tabs" PanelClass="config-editor-tab-panel" Rounded="false" Elevation="0">
                                    <MudTabPanel Text="@L("configs-controls")" Icon="@Icons.Material.Filled.Tune">
                                        @if (!string.IsNullOrWhiteSpace(_editorParseError))
                                        {
                                            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">@_editorParseError</MudAlert>
                                        }
                                        else
                                        {
                                            <ConfigStructuredEditor Title="@(SelectedConfig?.DisplayName ?? L("configs-config"))"
                                                                    Value="@_editorNode"
                                                                    AddableObjectPaths="@(_snapshot?.AddableObjectPaths ?? _emptyAddableObjectPaths)"
                                                                    IgnoredSectionPaths="@(_snapshot?.IgnoredSectionPaths ?? _emptyIgnoredSectionPaths)"
                                                                    ValueChanged="OnStructuredEditorChanged" />
                                        }
                                    </MudTabPanel>
                                    <MudTabPanel Text="@L("configs-raw-json")" Icon="@Icons.Material.Filled.DataObject">
                                        <MudTextField T="string"
                                                      Value="@_editorJson"
                                                      ValueChanged="OnEditorJsonChanged"
                                                      Immediate="true"
                                                      Lines="28"
                                                      Variant="Variant.Outlined"
                                                      Class="config-editor-json spt-mono" />
                                    </MudTabPanel>
                                </MudTabs>
                            </MudPaper>

                            <MudStack Row AlignItems="AlignItems.End" Justify="Justify.SpaceBetween" Class="config-editor-footer">
                                <MudStack Row Spacing="2" Class="config-editor-preset-actions">
                                    <MudSelect T="string"
                                               Label="@L("configs-preset")"
                                               Variant="Variant.Outlined"
                                               Dense="true"
                                               Value="@_selectedPresetId"
                                               ValueChanged="OnSelectedPresetChanged"
                                               Class="config-editor-preset-select">
                                        @foreach (var preset in _presets)
                                        {
                                            <MudSelectItem T="string" Value="@preset.Id">@preset.Name (@preset.ConfigJsonById.Count @L("configs-count-label").ToLowerInvariant())</MudSelectItem>
                                        }
                                    </MudSelect>

                                    <MudTextField T="string"
                                                  Label="@L("configs-preset-name")"
                                                  Variant="Variant.Outlined"
                                                  Dense="true"
                                                  @bind-Value="_presetName"
                                                  Class="config-editor-preset-name" />

                                    <MudTooltip Text="@L("configs-save-preset")">
                                        <MudIconButton Icon="@Icons.Material.Filled.BookmarkAdd"
                                                       Variant="Variant.Outlined"
                                                       Color="Color.Secondary"
                                                       Disabled="@_isWorking"
                                                       OnClick="SavePreset"
                                                       aria-label="@L("configs-save-preset")" />
                                    </MudTooltip>
                                    <MudTooltip Text="@L("configs-delete-preset")">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Variant="Variant.Outlined"
                                                       Color="Color.Secondary"
                                                       Disabled="@(_isWorking || string.IsNullOrWhiteSpace(_selectedPresetId))"
                                                       OnClick="DeletePreset"
                                                       aria-label="@L("configs-delete-preset")" />
                                    </MudTooltip>
                                    <MudTooltip Text="@L("configs-apply-preset-tooltip")">
                                        <MudIconButton Icon="@Icons.Material.Filled.PlaylistAddCheck"
                                                       Variant="Variant.Outlined"
                                                       Color="Color.Secondary"
                                                       Disabled="@(_isWorking || string.IsNullOrWhiteSpace(_selectedPresetId))"
                                                       OnClick="ApplySelectedPreset"
                                                       aria-label="@L("configs-apply-preset")" />
                                    </MudTooltip>
                                </MudStack>

                                <MudStack Row Spacing="2" Class="config-editor-apply-actions">
                                    @if (SelectedConfig?.IsRegisteredConfig == true)
                                    {
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Secondary"
                                                   Class="config-editor-save-button"
                                                   StartIcon="@Icons.Material.Filled.Save"
                                                   Disabled="@_isWorking"
                                                   OnClick="SaveToDisk">
                                            @L("common-save")
                                        </MudButton>
                                    }
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Warning"
                                               Class="config-editor-apply-button"
                                               StartIcon="@Icons.Material.Filled.PublishedWithChanges"
                                               Disabled="@_isWorking"
                                               OnClick="ApplyToRuntime">
                                        @L("common-apply")
                                    </MudButton>
                                </MudStack>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                </div>
            }
        </MudStack>
    </MudContainer>
</div>
