@page "/example-page"
@attribute [Authorize]
@using SPTarkov.Server.Web.Layout
@layout BaseMudBlazorLayout
@inject WebLocalizationService WebLocalizationService

<PageTitle>@WebLocalizationService.GetText("example-page-title")</PageTitle>

<div class="spt-page spt-page-centered">
    <MudContainer MaxWidth="MaxWidth.Small" Class="spt-container">
        <MudCard Elevation="0" Class="spt-card pb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5" Align="Align.Center" Class="spt-title">@WebLocalizationService.GetText("example-heading")</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <div class="d-flex justify-center">
                    <MudText Typo="Typo.h5" Class="ml-1 mt-5 spt-accent">@WebLocalizationService.GetText("example-subtitle")</MudText>
                </div>
                <MudList T="string" Class="mx-auto mt-4" Style="width:300px;">
                    <MudListItem Icon="@Icons.Material.Filled.Star" IconColor="Color.Warning">@WebLocalizationService.GetText("example-feature-1")</MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.Star" IconColor="Color.Warning">@WebLocalizationService.GetText("example-feature-2")</MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.Star" IconColor="Color.Warning">@WebLocalizationService.GetText("example-feature-3")</MudListItem>
                </MudList>
            </MudCardContent>
        </MudCard>
    </MudContainer>
</div>
