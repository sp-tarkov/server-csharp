@page "/credentials"
@attribute [Authorize(Policy = "Administrator")]
@using SPTarkov.Server.Core.Models.Spt.Config
@using SPTarkov.Server.Web.Layout
@using SPTarkov.Server.Web.Services
@layout BaseMudBlazorLayout
@inject AuthService AuthService
@inject ISnackbar Snackbar
@inject WebLocalizationService WebLocalizationService

<PageTitle>@L("credentials-page-title")</PageTitle>

<div class="credentials-page spt-page">
    <MudContainer MaxWidth="MaxWidth.False" Class="credentials-page-container pa-6">
        <MudStack Spacing="4">
            <MudPaper Elevation="0" Class="credentials-header spt-panel pa-5">
                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="credentials-header-content">
                    <MudStack Spacing="1">
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="3" Class="credentials-title-row">
                            <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Color="Color.Warning" Size="Size.Large" />
                            <MudText Typo="Typo.h3">@L("credentials-heading")</MudText>
                        </MudStack>
                        <MudText Typo="Typo.body2">@L("credentials-subtitle")</MudText>
                    </MudStack>

                    <MudStack Row Spacing="2" Class="credentials-stat-stack">
                        <MudPaper Elevation="0" Class="credentials-stat spt-panel pa-3">
                            <MudText Typo="Typo.caption">@L("credentials-users")</MudText>
                            <MudText Typo="Typo.h5">@_credentials.Count.ToString("N0")</MudText>
                        </MudPaper>
                        <MudPaper Elevation="0" Class="credentials-stat spt-panel pa-3">
                            <MudText Typo="Typo.caption">@L("credentials-admins")</MudText>
                            <MudText Typo="Typo.h5">@(_credentials.Count(credential => credential.IsAdministrator).ToString("N0"))</MudText>
                        </MudPaper>
                    </MudStack>
                </MudStack>
            </MudPaper>

            <div class="credentials-grid">
                <MudPaper Elevation="0" Class="credentials-sidebar spt-panel pa-4">
                    <MudStack Spacing="4">
                        <MudStack Spacing="3">
                            <MudText Typo="Typo.h6">@L("credentials-create-heading")</MudText>

                            <MudTextField T="string"
                                          Label="@L("credentials-username")"
                                          Variant="Variant.Outlined"
                                          Immediate="true"
                                          Value="@_newUsername"
                                          ValueChanged="@((value) => _newUsername = value)" />

                            <MudTextField T="string"
                                          Label="@L("credentials-password")"
                                          Variant="Variant.Outlined"
                                          InputType="InputType.Password"
                                          Immediate="true"
                                          Value="@_newPassword"
                                          ValueChanged="@((value) => _newPassword = value)" />

                            <MudCheckBox T="bool"
                                         Label="@L("credentials-administrator")"
                                         Color="Color.Warning"
                                         Value="@_newIsAdministrator"
                                         ValueChanged="@((value) => _newIsAdministrator = value)" />

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Warning"
                                       Class="credentials-primary-button"
                                       StartIcon="@Icons.Material.Filled.PersonAdd"
                                       Disabled="@_isBusy"
                                       OnClick="CreateCredential">
                                @L("credentials-create")
                            </MudButton>
                        </MudStack>

                        <MudDivider />

                        <MudStack Spacing="3">
                            <MudText Typo="Typo.h6">@L("credentials-selected-heading")</MudText>

                            @if (SelectedCredential is null)
                            {
                                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="credentials-empty-state">
                                    <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Color="Color.Warning" Size="Size.Large" />
                                    <MudText Typo="Typo.body2" Align="Align.Center">@L("credentials-select-empty")</MudText>
                                </MudStack>
                            }
                            else
                            {
                                <MudStack Spacing="3">
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.subtitle2">@SelectedCredential.Username</MudText>
                                        <MudChip T="string" Size="Size.Small" Color="@GetCredentialStatusColor(SelectedCredential)">
                                            @GetCredentialStatus(SelectedCredential)
                                        </MudChip>
                                    </MudStack>

                                    <MudTextField T="string"
                                                  Label="@L("credentials-password")"
                                                  Variant="Variant.Outlined"
                                                  InputType="InputType.Password"
                                                  Immediate="true"
                                                  Value="@_editPassword"
                                                  ValueChanged="@((value) => _editPassword = value)" />

                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Secondary"
                                               StartIcon="@Icons.Material.Filled.Password"
                                               Disabled="@(!CanSaveSelectedPassword)"
                                               OnClick="SaveSelectedPassword">
                                        @L("credentials-save-password")
                                    </MudButton>

                                    <MudDivider />

                                    <MudStack Spacing="2">
                                        <MudText Typo="Typo.subtitle2">@L("credentials-admin-access")</MudText>

                                        <div class="credentials-access-editor-row">
                                            <MudText Typo="Typo.body2">@GetCredentialStatus(SelectedCredential)</MudText>
                                            <MudCheckBox T="bool"
                                                         Label="@L("credentials-administrator")"
                                                         Color="Color.Warning"
                                                         Value="@SelectedCredential.IsAdministrator"
                                                         ValueChanged="UpdateSelectedAdministrator"
                                                         Disabled="@(!CanUpdateSelectedAdministrator)" />
                                        </div>
                                    </MudStack>

                                    <MudDivider />

                                    <MudTextField T="string"
                                                  Label="@L("credentials-type-username-delete")"
                                                  Variant="Variant.Outlined"
                                                  Immediate="true"
                                                  Value="@_deleteConfirmation"
                                                  ValueChanged="@((value) => _deleteConfirmation = value)" />

                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Error"
                                               StartIcon="@Icons.Material.Filled.DeleteForever"
                                               Disabled="@(!CanDeleteSelectedCredential)"
                                               OnClick="DeleteSelectedCredential">
                                        @L("credentials-delete")
                                    </MudButton>
                                </MudStack>
                            }
                        </MudStack>
                    </MudStack>
                </MudPaper>

                <MudPaper Elevation="0" Class="credentials-results spt-panel pa-4">
                    <MudStack Spacing="3">
                        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="credentials-section-toolbar">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.h6">@L("credentials-table-heading")</MudText>
                                <MudText Typo="Typo.caption">@_credentials.Count.ToString("N0") @L("credentials-users-loaded")</MudText>
                            </MudStack>

                            <MudTooltip Text="@L("credentials-refresh-list")">
                                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                               Variant="Variant.Outlined"
                                               Color="Color.Secondary"
                                               Disabled="@_isBusy"
                                               OnClick="RefreshCredentials"
                                               aria-label="@L("credentials-refresh-credentials")" />
                            </MudTooltip>
                        </MudStack>

                        <MudTable T="AuthUserCredential"
                                  Items="@_credentials"
                                  Dense="true"
                                  Hover="true"
                                  Bordered="false"
                                  Striped="true"
                                  FixedHeader="true"
                                  Height="calc(100vh - 320px)"
                                  RowClassFunc="GetCredentialRowClass"
                                  OnRowClick="SelectCredential">
                            <HeaderContent>
                                <MudTh>@L("credentials-username")</MudTh>
                                <MudTh>@L("credentials-password")</MudTh>
                                <MudTh>@L("credentials-administrator")</MudTh>
                                <MudTh>@L("credentials-status")</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Username">
                                    <MudText Typo="Typo.body2" Class="credentials-row-title">@context.Username</MudText>
                                </MudTd>
                                <MudTd DataLabel="Password">
                                    <MudText Typo="Typo.caption" Class="credentials-mono">********</MudText>
                                </MudTd>
                                <MudTd DataLabel="Administrator">
                                    <MudChip T="string" Size="Size.Small" Color="@GetCredentialStatusColor(context)">
                                        @(context.IsAdministrator ? L("common-yes") : L("common-no"))
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="Status">
                                    <MudChip T="string" Size="Size.Small" Color="@GetCredentialStatusColor(context)">
                                        @GetCredentialStatus(context)
                                    </MudChip>
                                </MudTd>
                            </RowTemplate>
                            <PagerContent>
                                <MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" />
                            </PagerContent>
                        </MudTable>
                    </MudStack>
                </MudPaper>
            </div>
        </MudStack>
    </MudContainer>
</div>

@code {
    private readonly List<AuthUserCredential> _credentials = [];
    private string _currentUsername = string.Empty;
    private string _deleteConfirmation = string.Empty;
    private string _editPassword = string.Empty;
    private bool _isBusy;
    private bool _newIsAdministrator = true;
    private string _newPassword = string.Empty;
    private string _newUsername = string.Empty;
    private string? _selectedUsername;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private AuthUserCredential? SelectedCredential
    {
        get { return _credentials.FirstOrDefault(credential => credential.Username == _selectedUsername); }
    }

    private bool CanUpdateSelectedAdministrator
    {
        get
        {
            return SelectedCredential is not null
                && !_isBusy
                && !(IsCurrentUser(SelectedCredential) && SelectedCredential.IsAdministrator);
        }
    }

    private bool CanDeleteSelectedCredential
    {
        get
        {
            return SelectedCredential is not null
                && !_isBusy
                && !IsCurrentUser(SelectedCredential)
                && string.Equals(_deleteConfirmation.Trim(), SelectedCredential.Username, StringComparison.Ordinal);
        }
    }

    private bool CanSaveSelectedPassword
    {
        get { return SelectedCredential is not null && !_isBusy && !string.IsNullOrWhiteSpace(_editPassword); }
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            var authenticationState = await AuthenticationStateTask;
            _currentUsername = authenticationState.User.Identity?.Name ?? string.Empty;
        }

        RefreshCredentials();
    }

    private void RefreshCredentials()
    {
        _credentials.Clear();

        // The panel only needs the username and role. Empty the password.
        _credentials.AddRange(
            AuthService.Credentials
                .OrderBy(credential => credential.Username)
                .Select(credential => credential with { Password = string.Empty })
        );

        if (_selectedUsername is not null && _credentials.All(credential => credential.Username != _selectedUsername))
        {
            ClearSelectedCredential();
        }
    }

    private async Task CreateCredential()
    {
        var username = _newUsername.Trim();
        var password = _newPassword;
        var isAdministrator = _newIsAdministrator;

        if (string.IsNullOrWhiteSpace(username))
        {
            Snackbar.Add(L("credentials-username-required"), Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(password))
        {
            Snackbar.Add(L("credentials-password-required"), Severity.Warning);
            return;
        }

        await RunCredentialAction(async () =>
        {
            if (!await AuthService.TryCreateUser(username, password, isAdministrator))
            {
                Snackbar.Add(L("credentials-username-exists"), Severity.Warning);
                return;
            }

            _selectedUsername = username;
            _editPassword = string.Empty;
            _newUsername = string.Empty;
            _newPassword = string.Empty;
            _newIsAdministrator = true;
            Snackbar.Add(L("credentials-created"), Severity.Success);
        });
    }

    private async Task SaveSelectedPassword()
    {
        if (SelectedCredential is null || !CanSaveSelectedPassword)
        {
            return;
        }

        var username = SelectedCredential.Username;
        var password = _editPassword;

        await RunCredentialAction(async () =>
        {
            if (!await AuthService.TryUpdateUserPassword(username, password))
            {
                Snackbar.Add(L("credentials-password-update-failed"), Severity.Error);
                return;
            }

            Snackbar.Add(string.Format(L("credentials-password-updated"), username), Severity.Success);
        });
    }

    private async Task UpdateSelectedAdministrator(bool isAdministrator)
    {
        if (SelectedCredential is null || !CanUpdateSelectedAdministrator)
        {
            return;
        }

        var username = SelectedCredential.Username;

        await RunCredentialAction(async () =>
        {
            if (!await AuthService.TryUpdateUserAdministrator(username, isAdministrator))
            {
                Snackbar.Add(L("credentials-admin-update-failed"), Severity.Error);
                return;
            }

            Snackbar.Add(
                string.Format(isAdministrator ? L("credentials-now-admin") : L("credentials-no-longer-admin"), username),
                Severity.Success
            );
        });
    }

    private async Task DeleteSelectedCredential()
    {
        if (SelectedCredential is null || !CanDeleteSelectedCredential)
        {
            return;
        }

        var username = SelectedCredential.Username;

        await RunCredentialAction(async () =>
        {
            if (!await AuthService.TryDeleteUser(username))
            {
                Snackbar.Add(string.Format(L("credentials-delete-failed"), username), Severity.Error);
                return;
            }

            ClearSelectedCredential();
            Snackbar.Add(string.Format(L("credentials-deleted"), username), Severity.Success);
        });
    }

    private async Task RunCredentialAction(Func<Task> action)
    {
        _isBusy = true;

        try
        {
            await action();
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.InnerException?.Message ?? exception.Message, Severity.Error);
        }
        finally
        {
            RefreshCredentials();
            _isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task SelectCredential(TableRowClickEventArgs<AuthUserCredential> args)
    {
        if (args.Item is null)
        {
            return Task.CompletedTask;
        }

        _selectedUsername = args.Item.Username;
        _editPassword = string.Empty;
        _deleteConfirmation = string.Empty;

        return Task.CompletedTask;
    }

    private void ClearSelectedCredential()
    {
        _selectedUsername = null;
        _editPassword = string.Empty;
        _deleteConfirmation = string.Empty;
    }

    private string GetCredentialRowClass(AuthUserCredential credential, int rowNumber)
    {
        return credential.Username == _selectedUsername ? "credentials-selected-row" : string.Empty;
    }

    private bool IsCurrentUser(AuthUserCredential credential)
    {
        return !string.IsNullOrWhiteSpace(_currentUsername)
            && string.Equals(credential.Username, _currentUsername, StringComparison.Ordinal);
    }

    private string GetCredentialStatus(AuthUserCredential credential)
    {
        return credential.IsAdministrator ? L("credentials-administrator") : L("credentials-user");
    }

    private static Color GetCredentialStatusColor(AuthUserCredential credential)
    {
        return credential.IsAdministrator ? Color.Warning : Color.Info;
    }

    private string L(string key)
    {
        return WebLocalizationService.GetText(key);
    }
}
