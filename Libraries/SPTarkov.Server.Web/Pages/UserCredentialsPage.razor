@page "/credentials"
@attribute [Authorize(Roles = "Administrator")]
@using SPTarkov.Server.Core.Models.Spt.Config
@using SPTarkov.Server.Web.Layout
@using SPTarkov.Server.Web.Services
@layout BaseMudBlazorLayout
@inject AuthService AuthService
@inject ISnackbar Snackbar

<PageTitle>User Credentials - SPT Server</PageTitle>

<div class="credentials-page spt-page">
    <MudContainer MaxWidth="MaxWidth.False" Class="credentials-page-container pa-6">
        <MudStack Spacing="4">
            <MudPaper Elevation="0" Class="credentials-header spt-panel pa-5">
                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="credentials-header-content">
                    <MudStack Spacing="1">
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="3" Class="credentials-title-row">
                            <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Color="Color.Warning" Size="Size.Large" />
                            <MudText Typo="Typo.h3">User credentials</MudText>
                        </MudStack>
                        <MudText Typo="Typo.body2">Manage local web sign-in users, passwords, and roles.</MudText>
                    </MudStack>

                    <MudStack Row Spacing="2" Class="credentials-stat-stack">
                        <MudPaper Elevation="0" Class="credentials-stat spt-panel pa-3">
                            <MudText Typo="Typo.caption">Users</MudText>
                            <MudText Typo="Typo.h5">@_credentials.Count.ToString("N0")</MudText>
                        </MudPaper>
                        <MudPaper Elevation="0" Class="credentials-stat spt-panel pa-3">
                            <MudText Typo="Typo.caption">Admins</MudText>
                            <MudText Typo="Typo.h5">@_credentials.Count(HasAdministratorRole).ToString("N0")</MudText>
                        </MudPaper>
                    </MudStack>
                </MudStack>
            </MudPaper>

            <div class="credentials-grid">
                <MudPaper Elevation="0" Class="credentials-sidebar spt-panel pa-4">
                    <MudStack Spacing="4">
                        <MudStack Spacing="3">
                            <MudText Typo="Typo.h6">Create credential</MudText>

                            <MudTextField T="string"
                                          Label="Username"
                                          Variant="Variant.Outlined"
                                          Immediate="true"
                                          Value="@_newUsername"
                                          ValueChanged="@((value) => _newUsername = value)" />

                            <MudTextField T="string"
                                          Label="Password"
                                          Variant="Variant.Outlined"
                                          InputType="InputType.Password"
                                          Immediate="true"
                                          Value="@_newPassword"
                                          ValueChanged="@((value) => _newPassword = value)" />

                            <MudTextField T="string"
                                          Label="Roles"
                                          Variant="Variant.Outlined"
                                          Immediate="true"
                                          Value="@_newRoles"
                                          ValueChanged="@((value) => _newRoles = value)" />

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Warning"
                                       Class="credentials-primary-button"
                                       StartIcon="@Icons.Material.Filled.PersonAdd"
                                       Disabled="@_isBusy"
                                       OnClick="CreateCredential">
                                Create
                            </MudButton>
                        </MudStack>

                        <MudDivider />

                        <MudStack Spacing="3">
                            <MudText Typo="Typo.h6">Selected credential</MudText>

                            @if (SelectedCredential is null)
                            {
                                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="credentials-empty-state">
                                    <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Color="Color.Warning" Size="Size.Large" />
                                    <MudText Typo="Typo.body2" Align="Align.Center">Select a credential from the table.</MudText>
                                </MudStack>
                            }
                            else
                            {
                                <MudStack Spacing="3">
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.subtitle2">@SelectedCredential.Username</MudText>
                                        <MudStack Row Spacing="1" Class="credentials-role-row">
                                            @foreach (var role in GetCredentialRoles(SelectedCredential))
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="@GetRoleColor(role)">@role</MudChip>
                                            }
                                        </MudStack>
                                    </MudStack>

                                    <MudTextField T="string"
                                                  Label="Password"
                                                  Variant="Variant.Outlined"
                                                  InputType="InputType.Password"
                                                  Immediate="true"
                                                  Value="@_editPassword"
                                                  ValueChanged="@((value) => _editPassword = value)" />

                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Secondary"
                                               StartIcon="@Icons.Material.Filled.Password"
                                               Disabled="@(!CanSaveSelectedPassword)"
                                               OnClick="SaveSelectedPassword">
                                        Save password
                                    </MudButton>

                                    <MudDivider />

                                    <MudStack Spacing="2">
                                        <MudText Typo="Typo.subtitle2">Roles</MudText>

                                        @foreach (var role in GetCredentialRoles(SelectedCredential))
                                        {
                                            <div class="credentials-role-editor-row">
                                                <MudText Typo="Typo.body2">@role</MudText>
                                                <MudTooltip Text="Remove role">
                                                    <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline"
                                                                   Size="Size.Small"
                                                                   Color="Color.Error"
                                                                   Disabled="@(!CanRemoveRole(SelectedCredential, role))"
                                                                   OnClick="@(() => RemoveSelectedRole(role))"
                                                                   aria-label="Remove role" />
                                                </MudTooltip>
                                            </div>
                                        }

                                        <MudStack Row Spacing="2" Class="credentials-role-add-row">
                                            <MudTextField T="string"
                                                          Label="New role"
                                                          Variant="Variant.Outlined"
                                                          Immediate="true"
                                                          Value="@_newRole"
                                                          ValueChanged="@((value) => _newRole = value)" />

                                            <MudTooltip Text="Add role">
                                                <MudIconButton Icon="@Icons.Material.Filled.Add"
                                                               Variant="Variant.Outlined"
                                                               Color="Color.Secondary"
                                                               Disabled="@(!CanAddSelectedRole)"
                                                               OnClick="AddSelectedRole"
                                                               aria-label="Add role" />
                                            </MudTooltip>
                                        </MudStack>
                                    </MudStack>

                                    <MudDivider />

                                    <MudTextField T="string"
                                                  Label="Type username to delete"
                                                  Variant="Variant.Outlined"
                                                  Immediate="true"
                                                  Value="@_deleteConfirmation"
                                                  ValueChanged="@((value) => _deleteConfirmation = value)" />

                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Error"
                                               StartIcon="@Icons.Material.Filled.DeleteForever"
                                               Disabled="@(!CanDeleteSelectedCredential)"
                                               OnClick="DeleteSelectedCredential">
                                        Delete credential
                                    </MudButton>
                                </MudStack>
                            }
                        </MudStack>
                    </MudStack>
                </MudPaper>

                <MudPaper Elevation="0" Class="credentials-results spt-panel pa-4">
                    <MudStack Spacing="3">
                        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="credentials-section-toolbar">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.h6">Credentials</MudText>
                                <MudText Typo="Typo.caption">@_credentials.Count.ToString("N0") local web users loaded</MudText>
                            </MudStack>

                            <MudTooltip Text="Refresh list">
                                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                               Variant="Variant.Outlined"
                                               Color="Color.Secondary"
                                               Disabled="@_isBusy"
                                               OnClick="RefreshCredentials"
                                               aria-label="Refresh credentials" />
                            </MudTooltip>
                        </MudStack>

                        <MudTable T="AuthUserCredential"
                                  Items="@_credentials"
                                  Dense="true"
                                  Hover="true"
                                  Bordered="false"
                                  Striped="true"
                                  FixedHeader="true"
                                  Height="calc(100vh - 320px)"
                                  RowClassFunc="GetCredentialRowClass"
                                  OnRowClick="SelectCredential">
                            <HeaderContent>
                                <MudTh>Username</MudTh>
                                <MudTh>Password</MudTh>
                                <MudTh>Roles</MudTh>
                                <MudTh>Status</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Username">
                                    <MudText Typo="Typo.body2" Class="credentials-row-title">@context.Username</MudText>
                                </MudTd>
                                <MudTd DataLabel="Password">
                                    <MudText Typo="Typo.caption" Class="credentials-mono">********</MudText>
                                </MudTd>
                                <MudTd DataLabel="Roles">
                                    <MudStack Row Spacing="1" Class="credentials-role-row">
                                        @foreach (var role in GetCredentialRoles(context))
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="@GetRoleColor(role)">@role</MudChip>
                                        }
                                    </MudStack>
                                </MudTd>
                                <MudTd DataLabel="Status">
                                    <MudChip T="string" Size="Size.Small" Color="@GetCredentialStatusColor(context)">
                                        @GetCredentialStatus(context)
                                    </MudChip>
                                </MudTd>
                            </RowTemplate>
                            <PagerContent>
                                <MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" />
                            </PagerContent>
                        </MudTable>
                    </MudStack>
                </MudPaper>
            </div>
        </MudStack>
    </MudContainer>
</div>

@code {
    private const string AdministratorRole = "Administrator";

    private readonly List<AuthUserCredential> _credentials = [];
    private string _currentUsername = string.Empty;
    private string _deleteConfirmation = string.Empty;
    private string _editPassword = string.Empty;
    private bool _isBusy;
    private string _newPassword = string.Empty;
    private string _newRole = string.Empty;
    private string _newRoles = AdministratorRole;
    private string _newUsername = string.Empty;
    private string? _selectedUsername;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private AuthUserCredential? SelectedCredential
    {
        get { return _credentials.FirstOrDefault(credential => credential.Username == _selectedUsername); }
    }

    private bool CanAddSelectedRole
    {
        get
        {
            return SelectedCredential is not null
                && !_isBusy
                && !string.IsNullOrWhiteSpace(_newRole)
                && !_newRole.Contains(',');
        }
    }

    private bool CanDeleteSelectedCredential
    {
        get
        {
            return SelectedCredential is not null
                && !_isBusy
                && !IsCurrentUser(SelectedCredential)
                && string.Equals(_deleteConfirmation.Trim(), SelectedCredential.Username, StringComparison.Ordinal);
        }
    }

    private bool CanSaveSelectedPassword
    {
        get { return SelectedCredential is not null && !_isBusy && !string.IsNullOrWhiteSpace(_editPassword); }
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            var authenticationState = await AuthenticationStateTask;
            _currentUsername = authenticationState.User.Identity?.Name ?? string.Empty;
        }

        RefreshCredentials();
    }

    private void RefreshCredentials()
    {
        _credentials.Clear();
        _credentials.AddRange(AuthService.Credentials.OrderBy(credential => credential.Username));

        if (_selectedUsername is not null && _credentials.All(credential => credential.Username != _selectedUsername))
        {
            ClearSelectedCredential();
        }
    }

    private async Task CreateCredential()
    {
        var username = _newUsername.Trim();
        var password = _newPassword.Trim();
        var roles = NormalizeRoles(_newRoles);

        if (string.IsNullOrWhiteSpace(username))
        {
            Snackbar.Add("Username is required.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(password))
        {
            Snackbar.Add("Password is required.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(roles))
        {
            Snackbar.Add("At least one role is required.", Severity.Warning);
            return;
        }

        await RunCredentialAction(async () =>
        {
            if (!await AuthService.TryCreateUser(username, password, roles))
            {
                Snackbar.Add("That username already exists.", Severity.Warning);
                return;
            }

            _selectedUsername = username;
            _editPassword = password;
            _newUsername = string.Empty;
            _newPassword = string.Empty;
            _newRoles = AdministratorRole;
            Snackbar.Add("Credential created.", Severity.Success);
        });
    }

    private async Task SaveSelectedPassword()
    {
        if (SelectedCredential is null || !CanSaveSelectedPassword)
        {
            return;
        }

        var username = SelectedCredential.Username;
        var password = _editPassword.Trim();

        await RunCredentialAction(async () =>
        {
            if (!await AuthService.TryUpdateUserPassword(username, password))
            {
                Snackbar.Add("Could not update password.", Severity.Error);
                return;
            }

            Snackbar.Add($"Updated password for {username}.", Severity.Success);
        });
    }

    private async Task AddSelectedRole()
    {
        if (SelectedCredential is null || !CanAddSelectedRole)
        {
            return;
        }

        var username = SelectedCredential.Username;
        var role = _newRole.Trim();

        await RunCredentialAction(async () =>
        {
            if (!await AuthService.TryAddUserRole(username, role))
            {
                Snackbar.Add("That role is already assigned.", Severity.Warning);
                return;
            }

            _newRole = string.Empty;
            Snackbar.Add($"Added {role} to {username}.", Severity.Success);
        });
    }

    private async Task RemoveSelectedRole(string role)
    {
        if (SelectedCredential is null || !CanRemoveRole(SelectedCredential, role))
        {
            return;
        }

        var username = SelectedCredential.Username;

        await RunCredentialAction(async () =>
        {
            if (!await AuthService.TryRemoveUserRole(username, role))
            {
                Snackbar.Add("Could not remove role.", Severity.Error);
                return;
            }

            Snackbar.Add($"Removed {role} from {username}.", Severity.Success);
        });
    }

    private async Task DeleteSelectedCredential()
    {
        if (SelectedCredential is null || !CanDeleteSelectedCredential)
        {
            return;
        }

        var username = SelectedCredential.Username;

        await RunCredentialAction(async () =>
        {
            if (!await AuthService.TryDeleteUser(username))
            {
                Snackbar.Add($"Could not delete {username}.", Severity.Error);
                return;
            }

            ClearSelectedCredential();
            Snackbar.Add($"Deleted {username}.", Severity.Success);
        });
    }

    private async Task RunCredentialAction(Func<Task> action)
    {
        _isBusy = true;

        try
        {
            await action();
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.InnerException?.Message ?? exception.Message, Severity.Error);
        }
        finally
        {
            RefreshCredentials();
            _isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task SelectCredential(TableRowClickEventArgs<AuthUserCredential> args)
    {
        _selectedUsername = args.Item.Username;
        _editPassword = args.Item.Password;
        _newRole = string.Empty;
        _deleteConfirmation = string.Empty;

        return Task.CompletedTask;
    }

    private void ClearSelectedCredential()
    {
        _selectedUsername = null;
        _editPassword = string.Empty;
        _newRole = string.Empty;
        _deleteConfirmation = string.Empty;
    }

    private string GetCredentialRowClass(AuthUserCredential credential, int rowNumber)
    {
        return credential.Username == _selectedUsername ? "credentials-selected-row" : string.Empty;
    }

    private bool CanRemoveRole(AuthUserCredential credential, string role)
    {
        return !_isBusy && !(IsCurrentUser(credential) && string.Equals(role, AdministratorRole, StringComparison.OrdinalIgnoreCase));
    }

    private bool IsCurrentUser(AuthUserCredential credential)
    {
        return !string.IsNullOrWhiteSpace(_currentUsername)
            && string.Equals(credential.Username, _currentUsername, StringComparison.Ordinal);
    }

    private static bool HasAdministratorRole(AuthUserCredential credential)
    {
        return GetCredentialRoles(credential).Any(role => string.Equals(role, AdministratorRole, StringComparison.OrdinalIgnoreCase));
    }

    private static string GetCredentialStatus(AuthUserCredential credential)
    {
        return HasAdministratorRole(credential) ? "Administrator" : "User";
    }

    private static Color GetCredentialStatusColor(AuthUserCredential credential)
    {
        return HasAdministratorRole(credential) ? Color.Warning : Color.Info;
    }

    private static Color GetRoleColor(string role)
    {
        return string.Equals(role, AdministratorRole, StringComparison.OrdinalIgnoreCase) ? Color.Warning : Color.Info;
    }

    private static IReadOnlyList<string> GetCredentialRoles(AuthUserCredential credential)
    {
        return credential.Roles.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    }

    private static string NormalizeRoles(string roles)
    {
        return string.Join(", ", roles.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct());
    }
}
