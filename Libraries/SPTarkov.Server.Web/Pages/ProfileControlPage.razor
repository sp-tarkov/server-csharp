@page "/profiles"
@attribute [Authorize(Policy = "Administrator")]
@using SPTarkov.Server.Core.Models.Common
@using SPTarkov.Server.Core.Models.Eft.Profile
@using SPTarkov.Server.Core.Servers
@using SPTarkov.Server.Core.Services
@using SPTarkov.Server.Core.Utils
@using SPTarkov.Server.Web.Components.Database
@using SPTarkov.Server.Web.Components.Profiles
@using SPTarkov.Server.Web.Layout
@using SPTarkov.Server.Web.Models.Database
@using SPTarkov.Server.Web.Models.Profiles
@using SPTarkov.Server.Web.Utils
@using BotHideoutArea = SPTarkov.Server.Core.Models.Eft.Common.Tables.BotHideoutArea
@using CommonSkill = SPTarkov.Server.Core.Models.Eft.Common.Tables.CommonSkill
@using CustomisationTypeId = SPTarkov.Server.Core.Models.Eft.Common.Tables.CustomisationTypeId
@using PmcData = SPTarkov.Server.Core.Models.Eft.Common.PmcData
@using Production = SPTarkov.Server.Core.Models.Eft.Common.Tables.Production
@using ProfileQuestStatus = SPTarkov.Server.Core.Models.Eft.Common.Tables.QuestStatus
@using Quest = SPTarkov.Server.Core.Models.Eft.Common.Tables.Quest
@using QuestStatusEnum = SPTarkov.Server.Core.Models.Enums.QuestStatusEnum
@using TemplateSide = SPTarkov.Server.Core.Models.Eft.Common.Tables.TemplateSide
@layout BaseMudBlazorLayout
@inject CreateProfileService CreateProfileService
@inject DatabaseService DatabaseService
@inject HashUtil HashUtil
@inject JsonUtil JsonUtil
@inject ISnackbar Snackbar
@inject SaveServer SaveServer

<PageTitle>Profile Control - SPT Server</PageTitle>

<div class="profiles-page spt-page">
    <DatabaseLoadingOverlay Visible="@_isDetailsLoading"
                            LoadingTitle="Loading profile details"
                            LoadingMessage="@_detailsLoadingMessage" />

    <MudContainer MaxWidth="MaxWidth.False" Class="profiles-page-container pa-6">
        <MudStack Spacing="4">
            <ProfileControlHeader Profiles="@_profiles" />

            <div class="profiles-grid">
                <MudPaper Elevation="0" Class="profiles-sidebar spt-panel pa-4">
                    <MudStack Spacing="4">
                        <ProfileCreatePanel Editions="@_editions"
                                            Username="@_newUsername"
                                            UsernameChanged="@((value) => _newUsername = value)"
                                            Edition="@_newEdition"
                                            EditionChanged="@((value) => _newEdition = value)"
                                            IsBusy="@_isBusy"
                                            OnCreate="CreateProfile" />

                        <MudDivider />

                        <ProfileSelectedPanel Profile="@SelectedProfile"
                                              DeleteConfirmation="@_deleteConfirmation"
                                              DeleteConfirmationChanged="@((value) => _deleteConfirmation = value)"
                                              CanDelete="@CanDeleteSelectedProfile"
                                              OnDelete="DeleteSelectedProfile" />
                    </MudStack>
                </MudPaper>

                <ProfileTable Profiles="@_profiles"
                              SelectedProfileId="@_selectedProfileId"
                              IsBusy="@_isBusy"
                              OnRefresh="RefreshProfiles"
                              OnSaveAll="SaveAllProfiles"
                              OnSaveProfile="SaveProfile"
                              OnReloadProfile="ReloadProfile"
                              SelectedProfileChanged="SelectProfile" />
            </div>

            <ProfileRecordDetailsModal Details="@_selectedProfileDetails"
                                       Open="@_isDetailsOpen"
                                       OnClose="CloseDetails" />
        </MudStack>
    </MudContainer>
</div>

@code {
    private const string BearSide = "Bear";
    private const string UsecSide = "Usec";

    private readonly List<ProfileSummary> _profiles = [];
    private readonly List<string> _editions = [];
    private readonly Dictionary<string, ProfileDetails> _profileDetailsCache = [];
    private string _deleteConfirmation = string.Empty;
    private string _detailsLoadingMessage = "Preparing profile properties.";
    private bool _isBusy;
    private bool _isDetailsOpen;
    private bool _isDetailsLoading;
    private string _newEdition = string.Empty;
    private string _newUsername = string.Empty;
    private int _profileDetailsRequestId;
    private ProfileDetails? _selectedProfileDetails;
    private string? _selectedProfileId;

    private ProfileSummary? SelectedProfile
    {
        get { return _profiles.FirstOrDefault(profile => profile.Id == _selectedProfileId); }
    }

    private bool CanDeleteSelectedProfile
    {
        get
        {
            return SelectedProfile is not null
                && !string.IsNullOrWhiteSpace(_deleteConfirmation)
                && string.Equals(_deleteConfirmation.Trim(), SelectedProfile.Username, StringComparison.Ordinal);
        }
    }

    protected override void OnInitialized()
    {
        _editions.AddRange(DatabaseService.GetProfileTemplates().Keys.OrderBy(edition => edition));
        _newEdition = _editions.FirstOrDefault() ?? string.Empty;
        RefreshProfiles();
    }

    private void RefreshProfiles()
    {
        InvalidateProfileDetails();
        _profiles.Clear();
        _profiles.AddRange(
            SaveServer.GetProfiles()
                .OrderBy(profile => profile.Value.ProfileInfo?.Username)
                .Select(profile => BuildProfileSummary(profile.Key, profile.Value))
        );

        if (_selectedProfileId is not null && _profiles.All(profile => profile.Id != _selectedProfileId))
        {
            ClearSelectedProfile();
            return;
        }

        if (_isDetailsOpen && SelectedProfile is null)
        {
            CloseDetails();
        }
    }

    private async Task CreateProfile()
    {
        if (!ValidateCreateForm())
        {
            return;
        }

        await RunProfileAction(async () =>
        {
            var profileId = new MongoId();
            var profileInfo = new Info
            {
                ProfileId = profileId,
                ScavengerId = new MongoId(),
                Aid = HashUtil.GenerateAccountId(),
                Username = _newUsername.Trim(),
                IsWiped = true,
                Edition = _newEdition,
            };

            SaveServer.CreateProfile(profileInfo);
            await SaveServer.LoadProfileAsync(profileId);
            await SaveServer.SaveProfileAsync(profileId);

            _selectedProfileId = profileId.ToString();
            _deleteConfirmation = string.Empty;
            _newUsername = string.Empty;
            Snackbar.Add("Profile created.", Severity.Success);
        });
    }

    private async Task SaveAllProfiles()
    {
        await RunProfileAction(async () =>
        {
            await SaveServer.SaveAsync();
            Snackbar.Add("All profiles saved.", Severity.Success);
        });
    }

    private async Task SaveProfile(ProfileSummary profile)
    {
        await RunProfileAction(async () =>
        {
            await SaveServer.SaveProfileAsync(new MongoId(profile.Id));
            Snackbar.Add($"Saved {profile.Username}.", Severity.Success);
        });
    }

    private async Task ReloadProfile(ProfileSummary profile)
    {
        await RunProfileAction(async () =>
        {
            await SaveServer.LoadProfileAsync(new MongoId(profile.Id));
            Snackbar.Add($"Reloaded {profile.Username}.", Severity.Info);
        });
    }

    private async Task DeleteSelectedProfile()
    {
        if (SelectedProfile is null || !CanDeleteSelectedProfile)
        {
            return;
        }

        var profile = SelectedProfile;
        await RunProfileAction(() =>
        {
            var deleted = SaveServer.RemoveProfile(new MongoId(profile.Id));
            Snackbar.Add(deleted ? $"Deleted {profile.Username}." : $"Could not delete {profile.Username}.", deleted ? Severity.Success : Severity.Error);
            ClearSelectedProfile();
            return Task.CompletedTask;
        });
    }

    private async Task RunProfileAction(Func<Task> action)
    {
        _isBusy = true;

        try
        {
            await action();
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.InnerException?.Message ?? exception.Message, Severity.Error);
        }
        finally
        {
            RefreshProfiles();
            _isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool ValidateCreateForm()
    {
        var username = _newUsername.Trim();

        if (string.IsNullOrWhiteSpace(username))
        {
            Snackbar.Add("Username is required.", Severity.Warning);
            return false;
        }

        if (string.IsNullOrWhiteSpace(_newEdition) || !DatabaseService.GetProfileTemplates().ContainsKey(_newEdition))
        {
            Snackbar.Add("Choose a valid edition.", Severity.Warning);
            return false;
        }

        if (SaveServer.GetProfiles().Values.Any(profile => string.Equals(profile.ProfileInfo?.Username, username, StringComparison.OrdinalIgnoreCase)))
        {
            Snackbar.Add("That username already exists.", Severity.Warning);
            return false;
        }

        return true;
    }

    private TemplateSide GetTemplateSide(string edition, string side)
    {
        var templates = DatabaseService.GetProfileTemplates();

        if (!templates.TryGetValue(edition, out var profileSides))
        {
            throw new InvalidOperationException($"Profile edition not found: {edition}");
        }

        return string.Equals(side, BearSide, StringComparison.OrdinalIgnoreCase)
            ? profileSides.Bear ?? throw new InvalidOperationException($"BEAR template not found for {edition}.")
            : profileSides.Usec ?? throw new InvalidOperationException($"USEC template not found for {edition}.");
    }

    private MongoId GetDefaultCustomizationId(TemplateSide templateSide, string side, string parentId)
    {
        var templateValue = parentId == CustomisationTypeId.HEAD
            ? templateSide.Character?.Customization?.Head
            : templateSide.Character?.Customization?.Voice;

        if (templateValue.HasValue)
        {
            return templateValue.Value;
        }

        var fallback = DatabaseService.GetCustomization()
            .Values.FirstOrDefault(item =>
                item.Parent == parentId
                && (item.Properties?.Side?.Any(value => string.Equals(value, side, StringComparison.OrdinalIgnoreCase)) ?? false)
            );

        return fallback?.Id ?? throw new InvalidOperationException($"No default customization found for {side}.");
    }

    private async Task SelectProfile(ProfileSummary profile)
    {
        _selectedProfileId = profile.Id;
        _deleteConfirmation = string.Empty;

        await OpenProfileDetails(profile);
    }

    private async Task OpenProfileDetails(ProfileSummary profile)
    {
        var requestId = ++_profileDetailsRequestId;

        if (_profileDetailsCache.TryGetValue(profile.Id, out var details))
        {
            _selectedProfileDetails = details;
            _isDetailsOpen = true;
            return;
        }

        _isDetailsLoading = true;
        _detailsLoadingMessage = $"Preparing {profile.Username} profile properties.";
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            details = await Task.Run(() => BuildProfileDetails(profile, SaveServer.GetProfile(new MongoId(profile.Id))));
            if (requestId != _profileDetailsRequestId || _selectedProfileId != profile.Id)
            {
                return;
            }

            _profileDetailsCache[profile.Id] = details;
            _selectedProfileDetails = details;
            _isDetailsOpen = true;
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.InnerException?.Message ?? exception.Message, Severity.Error);
        }
        finally
        {
            if (requestId == _profileDetailsRequestId)
            {
                _isDetailsLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void CloseDetails()
    {
        _isDetailsOpen = false;
    }

    private void ClearSelectedProfile()
    {
        _selectedProfileId = null;
        InvalidateProfileDetails();
        _deleteConfirmation = string.Empty;
    }

    private void InvalidateProfileDetails()
    {
        _profileDetailsCache.Clear();
        _selectedProfileDetails = null;
        _isDetailsOpen = false;
        _isDetailsLoading = false;
        _profileDetailsRequestId++;
    }

    private static ProfileSummary BuildProfileSummary(MongoId id, SptProfile profile)
    {
        var info = profile.ProfileInfo;
        var pmc = profile.CharacterData?.PmcData;
        var pmcInfo = pmc?.Info;
        var hasCharacter = !string.IsNullOrWhiteSpace(pmcInfo?.Nickname);
        var isInvalid = info?.InvalidOrUnloadableProfile == true;
        var isWiped = info?.IsWiped == true;
        var status = isInvalid ? "Invalid" : isWiped ? "Wiped" : hasCharacter ? "Ready" : "Account";

        return new ProfileSummary(
            id.ToString(),
            GetNonEmptyValue(info?.Username, "Unknown"),
            GetNonEmptyValue(pmcInfo?.Nickname, "n/a"),
            GetNonEmptyValue(pmcInfo?.Side, "n/a"),
            GetNonEmptyValue(info?.Edition, "n/a"),
            pmcInfo?.Level,
            pmcInfo?.Experience,
            pmc?.Inventory?.Items?.Count ?? 0,
            profile.CharacterData?.ScavData?.Info?.Level,
            hasCharacter,
            isInvalid,
            isWiped,
            status
        );
    }

    private ProfileDetails BuildProfileDetails(ProfileSummary summary, SptProfile profile)
    {
        var info = profile.ProfileInfo;
        var pmc = profile.CharacterData?.PmcData;
        var propertiesJson = JsonUtil.Serialize(profile, indented: true) ?? "{}";
        var properties = JsonPropertyFlattener.BuildProperties(propertiesJson);
        var detailSections = new List<DatabaseDetailSection>
        {
            new(
                "Account",
                [
                    new DatabaseDetailValue("Username", summary.Username),
                    new DatabaseDetailValue("Profile ID", summary.Id, true),
                    new DatabaseDetailValue("Scav ID", GetNonEmptyValue(info?.ScavengerId?.ToString(), "n/a"), true),
                    new DatabaseDetailValue("Account ID", GetAccountIdLabel(info?.Aid), true),
                    new DatabaseDetailValue("Edition", summary.Edition),
                    new DatabaseDetailValue("Status", summary.Status),
                ]
            ),
            new(
                "Character",
                [
                    new DatabaseDetailValue("PMC nickname", summary.Nickname),
                    new DatabaseDetailValue("Side", summary.Side),
                    new DatabaseDetailValue("PMC level", GetNumberLabel(summary.Level)),
                    new DatabaseDetailValue("PMC experience", GetNumberLabel(summary.Experience)),
                    new DatabaseDetailValue("Scav level", GetNumberLabel(summary.ScavLevel)),
                    new DatabaseDetailValue("Inventory items", GetNumberLabel(summary.ItemCount)),
                ]
            ),
        };

        var hideoutTimers = BuildHideoutTimerSection(pmc);
        if (hideoutTimers is not null)
        {
            detailSections.Add(hideoutTimers);
        }

        var quests = BuildQuestSection(pmc);
        if (quests is not null)
        {
            detailSections.Add(quests);
        }

        var skills = BuildSkillSection(pmc);
        if (skills is not null)
        {
            detailSections.Add(skills);
        }

        return new ProfileDetails(
            summary,
            detailSections,
            properties,
            propertiesJson
        );
    }

    private static DatabaseDetailSection? BuildHideoutTimerSection(PmcData? pmc)
    {
        if (pmc?.Hideout is null)
        {
            return null;
        }

        var now = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
        var readyCraftCount = 0;
        var readyConstructionCount = 0;
        var craftTimers = new List<(string Label, double RemainingSeconds)>();
        var constructionTimers = new List<(string Label, double RemainingSeconds)>();

        if (pmc.Hideout.Production is not null)
        {
            foreach (var productionEntry in pmc.Hideout.Production)
            {
                var production = productionEntry.Value;
                if (production is null)
                {
                    continue;
                }

                if (production.AvailableForFinish == true || production.SptIsComplete == true)
                {
                    readyCraftCount++;
                    continue;
                }

                if (production.Interrupted == true)
                {
                    continue;
                }

                var remainingSeconds = GetProductionRemainingSeconds(production, now);
                if (remainingSeconds is null)
                {
                    continue;
                }

                if (remainingSeconds <= 0)
                {
                    readyCraftCount++;
                    continue;
                }

                craftTimers.Add((GetProductionLabel(production), remainingSeconds.Value));
            }
        }

        if (pmc.Hideout.Areas is not null)
        {
            foreach (var area in pmc.Hideout.Areas)
            {
                if (area.Constructing != true || area.CompleteTime is not > 0)
                {
                    continue;
                }

                var remainingSeconds = area.CompleteTime.Value - now;
                if (remainingSeconds <= 0)
                {
                    readyConstructionCount++;
                    continue;
                }

                constructionTimers.Add((GetHideoutAreaLabel(area), remainingSeconds));
            }
        }

        if (pmc.Hideout.Improvements is not null)
        {
            foreach (var improvementEntry in pmc.Hideout.Improvements)
            {
                var improvement = improvementEntry.Value;
                if (improvement is null || improvement.Completed == true || improvement.ImproveCompleteTimestamp is not > 0)
                {
                    continue;
                }

                var remainingSeconds = improvement.ImproveCompleteTimestamp.Value - now;
                if (remainingSeconds <= 0)
                {
                    readyConstructionCount++;
                    continue;
                }

                constructionTimers.Add((GetImprovementLabel(improvementEntry.Key.ToString()), remainingSeconds));
            }
        }

        craftTimers.Sort((left, right) => left.RemainingSeconds.CompareTo(right.RemainingSeconds));
        constructionTimers.Sort((left, right) => left.RemainingSeconds.CompareTo(right.RemainingSeconds));

        var values = new List<DatabaseDetailValue>
        {
            new("Crafts active", craftTimers.Count.ToString("N0")),
            new("Crafts ready", readyCraftCount.ToString("N0")),
            new("Construction active", constructionTimers.Count.ToString("N0")),
            new("Construction ready", readyConstructionCount.ToString("N0")),
        };

        AddTimerValues(values, "Craft", craftTimers);
        AddTimerValues(values, "Build", constructionTimers);

        if (craftTimers.Count == 0)
        {
            values.Add(new DatabaseDetailValue("Craft timers", readyCraftCount > 0 ? $"{readyCraftCount:N0} ready" : "None active"));
        }

        if (constructionTimers.Count == 0)
        {
            values.Add(new DatabaseDetailValue("Construction timers", readyConstructionCount > 0 ? $"{readyConstructionCount:N0} ready" : "None active"));
        }

        return new DatabaseDetailSection("Hideout Timers", values);
    }

    private DatabaseDetailSection? BuildQuestSection(PmcData? pmc)
    {
        var profileQuests = pmc?.Quests;
        var repeatableQuests = pmc?.RepeatableQuests;

        if ((profileQuests is null || profileQuests.Count == 0) && (repeatableQuests is null || repeatableQuests.Count == 0))
        {
            return null;
        }

        var now = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
        var questDb = DatabaseService.GetQuests();
        var quests = profileQuests ?? [];
        var values = new List<DatabaseDetailValue>
        {
            new("Total quests", quests.Count.ToString("N0")),
            new("Started", CountQuestStatus(quests, QuestStatusEnum.Started).ToString("N0")),
            new("Ready to finish", CountQuestStatus(quests, QuestStatusEnum.AvailableForFinish).ToString("N0")),
            new("Available to start", CountQuestStatus(quests, QuestStatusEnum.AvailableForStart).ToString("N0")),
            new("Completed", CountQuestStatus(quests, QuestStatusEnum.Success).ToString("N0")),
            new("Failed", CountQuestStatus(quests, QuestStatusEnum.Fail, QuestStatusEnum.FailRestartable, QuestStatusEnum.MarkedAsFailed).ToString("N0")),
            new("Locked", CountQuestStatus(quests, QuestStatusEnum.Locked).ToString("N0")),
            new("Waiting", CountQuestStatus(quests, QuestStatusEnum.AvailableAfter).ToString("N0")),
        };

        var repeatableActiveCount = repeatableQuests?
            .SelectMany(group => group.ActiveQuests ?? [])
            .Count() ?? 0;
        values.Add(new DatabaseDetailValue("Repeatables active", repeatableActiveCount.ToString("N0")));

        var nextRepeatableReset = repeatableQuests?
            .Select(group => group.EndTime)
            .Where(endTime => endTime is > 0)
            .Select(endTime => endTime!.Value - now)
            .Where(remainingSeconds => remainingSeconds > 0)
            .OrderBy(remainingSeconds => remainingSeconds)
            .FirstOrDefault();
        values.Add(new DatabaseDetailValue("Repeatable reset", nextRepeatableReset is > 0 ? FormatTimerValue(nextRepeatableReset.Value) : "n/a"));

        AddQuestValues(values, "Ready quest", quests, questDb, QuestStatusEnum.AvailableForFinish);
        AddQuestValues(values, "Active quest", quests, questDb, QuestStatusEnum.Started);

        var nextUnlock = quests
            .Where(quest => quest.Status == QuestStatusEnum.AvailableAfter && quest.AvailableAfter is > 0)
            .Select(quest => (Quest: quest, RemainingSeconds: quest.AvailableAfter!.Value - now))
            .Where(quest => quest.RemainingSeconds > 0)
            .OrderBy(quest => quest.RemainingSeconds)
            .FirstOrDefault();

        if (nextUnlock.Quest is not null)
        {
            values.Add(new DatabaseDetailValue("Next unlock", $"{GetQuestLabel(nextUnlock.Quest, questDb)}: {FormatTimerValue(nextUnlock.RemainingSeconds)}"));
        }

        if (!quests.Any(quest => quest.Status is QuestStatusEnum.Started or QuestStatusEnum.AvailableForFinish))
        {
            values.Add(new DatabaseDetailValue("Current quests", "None active"));
        }

        return new DatabaseDetailSection("Quests", values);
    }

    private static DatabaseDetailSection? BuildSkillSection(PmcData? pmc)
    {
        var commonSkills = pmc?.Skills?.Common?.ToList();
        if (commonSkills is null || commonSkills.Count == 0)
        {
            return null;
        }

        var skillLevels = commonSkills
            .OrderByDescending(skill => skill.Progress)
            .Select(skill => (Skill: skill, Level: GetSkillLevel(skill.Progress)))
            .ToList();

        var highestSkill = skillLevels.First();
        var averageLevel = skillLevels.Average(skill => skill.Level);
        var eliteCount = skillLevels.Count(skill => skill.Level >= 51);
        var values = new List<DatabaseDetailValue>
        {
            new("Highest skill", $"{FormatSkillName(highestSkill.Skill.Id.ToString())} level {highestSkill.Level}"),
            new("Average level", averageLevel.ToString("0.#")),
            new("Elite skills", eliteCount.ToString("N0")),
            new("Total skill points", GetNumberLabel(pmc.Skills?.Points)),
        };

        AddSkillValue(values, commonSkills, "Crafting");
        AddSkillValue(values, commonSkills, "HideoutManagement");
        AddSkillValue(values, commonSkills, "Endurance");
        AddSkillValue(values, commonSkills, "Strength");
        AddSkillValue(values, commonSkills, "Health");
        AddSkillValue(values, commonSkills, "Metabolism");
        AddSkillValue(values, commonSkills, "Attention");
        AddSkillValue(values, commonSkills, "Intellect");

        return new DatabaseDetailSection("Skills", values);
    }

    private static void AddTimerValues(List<DatabaseDetailValue> values, string labelPrefix, IReadOnlyList<(string Label, double RemainingSeconds)> timers)
    {
        for (var index = 0; index < Math.Min(timers.Count, 3); index++)
        {
            var timer = timers[index];
            values.Add(new DatabaseDetailValue($"{labelPrefix} {index + 1}", $"{timer.Label}: {FormatTimerValue(timer.RemainingSeconds)}"));
        }
    }

    private static void AddSkillValue(List<DatabaseDetailValue> values, IReadOnlyList<CommonSkill> skills, string skillId)
    {
        var skill = skills.FirstOrDefault(skill => string.Equals(skill.Id.ToString(), skillId, StringComparison.Ordinal));
        if (skill is null)
        {
            return;
        }

        values.Add(new DatabaseDetailValue(FormatSkillName(skillId), FormatSkillLevel(skill)));
    }

    private static int CountQuestStatus(IReadOnlyList<ProfileQuestStatus> quests, params QuestStatusEnum[] statuses)
    {
        return quests.Count(quest => statuses.Contains(quest.Status));
    }

    private static void AddQuestValues(
        List<DatabaseDetailValue> values,
        string labelPrefix,
        IReadOnlyList<ProfileQuestStatus> quests,
        IReadOnlyDictionary<MongoId, Quest> questDb,
        QuestStatusEnum status
    )
    {
        var matchingQuests = quests
            .Where(quest => quest.Status == status)
            .OrderByDescending(quest => quest.StatusTimers.TryGetValue(status, out var statusTime) ? statusTime : quest.StartTime)
            .Take(3)
            .ToList();

        for (var index = 0; index < matchingQuests.Count; index++)
        {
            values.Add(new DatabaseDetailValue($"{labelPrefix} {index + 1}", GetQuestLabel(matchingQuests[index], questDb)));
        }
    }

    private static string GetQuestLabel(ProfileQuestStatus questStatus, IReadOnlyDictionary<MongoId, Quest> questDb)
    {
        if (!questDb.TryGetValue(questStatus.QId, out var quest))
        {
            return GetShortId(questStatus.QId.ToString());
        }

        return GetNonEmptyValue(
            quest.QuestName,
            GetNonEmptyValue(quest.Name, GetShortId(questStatus.QId.ToString()))
        );
    }

    private static double? GetProductionRemainingSeconds(Production production, long now)
    {
        if (production.ProductionTime is not > 0d || (production.InProgress != true && production.StartTimestamp is not > 0))
        {
            return null;
        }

        var storedProgress = Math.Max(0d, production.Progress ?? 0d);
        var elapsedFromStart = production.StartTimestamp is > 0
            ? Math.Max(0d, now - production.StartTimestamp.Value)
            : 0d;
        var skipTime = Math.Max(0d, production.SkipTime ?? 0d);
        var effectiveProgress = Math.Max(storedProgress, elapsedFromStart) + skipTime;

        return Math.Max(0d, production.ProductionTime.Value - effectiveProgress);
    }

    private static string GetProductionLabel(Production production)
    {
        var recipeId = production.RecipeId.ToString();
        var recipeLabel = string.IsNullOrWhiteSpace(recipeId) ? "Recipe" : $"Recipe {GetShortId(recipeId)}";

        if (production.SptIsScavCase == true)
        {
            return $"Scav case {GetShortId(recipeId)}";
        }

        if (production.SptIsCultistCircle == true)
        {
            return $"Cultist circle {GetShortId(recipeId)}";
        }

        return recipeLabel;
    }

    private static string GetHideoutAreaLabel(BotHideoutArea area)
    {
        var areaName = FormatSkillName(area.Type.ToString());
        return area.Level is null ? areaName : $"{areaName} level {area.Level.Value}";
    }

    private static string GetImprovementLabel(string improvementId)
    {
        return $"Improvement {GetShortId(improvementId)}";
    }

    private static string GetShortId(string value)
    {
        return value.Length <= 8 ? value : value[..8];
    }

    private static string FormatTimerValue(double remainingSeconds)
    {
        return remainingSeconds <= 0 ? "Ready" : $"{FormatDuration(remainingSeconds)} remaining";
    }

    private static string FormatDuration(double totalSeconds)
    {
        var duration = TimeSpan.FromSeconds(Math.Ceiling(Math.Max(0d, totalSeconds)));

        if (duration.TotalMinutes < 1)
        {
            return "<1m";
        }

        if (duration.TotalDays >= 1)
        {
            return $"{(int)duration.TotalDays}d {duration.Hours}h";
        }

        if (duration.TotalHours >= 1)
        {
            return $"{(int)duration.TotalHours}h {duration.Minutes}m";
        }

        return $"{duration.Minutes}m";
    }

    private static string FormatSkillLevel(CommonSkill skill)
    {
        var level = GetSkillLevel(skill.Progress);
        if (level >= 51)
        {
            return "Level 51 - elite";
        }

        var currentLevelProgress = Math.Clamp(skill.Progress - (level * 100d), 0d, 100d);
        return $"Level {level} - {currentLevelProgress:0.#}/100";
    }

    private static int GetSkillLevel(double progress)
    {
        return Math.Clamp((int)Math.Floor(Math.Max(0d, progress) / 100d), 0, 51);
    }

    private static string FormatSkillName(string value)
    {
        return value switch
        {
            "DMR" => "DMR",
            "HMG" => "HMG",
            "LMG" => "LMG",
            "SMG" => "SMG",
            "MagDrills" => "Magazine Drills",
            "HideoutManagement" => "Hideout Management",
            "RecoilControl" => "Recoil Control",
            "StressResistance" => "Stress Resistance",
            "WeaponTreatment" => "Weapon Maintenance",
            "TroubleShooting" => "Troubleshooting",
            _ => SplitPascalCase(value),
        };
    }

    private static string SplitPascalCase(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "n/a";
        }

        var result = value[0].ToString();
        for (var index = 1; index < value.Length; index++)
        {
            var character = value[index];
            var previous = value[index - 1];
            if (char.IsUpper(character) && !char.IsUpper(previous))
            {
                result += " ";
            }

            result += character;
        }

        return result;
    }

    private static string GetNonEmptyValue(string? value, string fallback)
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value;
    }

    private static string GetNumberLabel(int? value)
    {
        return value is null ? "n/a" : value.Value.ToString("N0");
    }

    private static string GetAccountIdLabel(int? value)
    {
        return value is null ? "n/a" : value.Value.ToString();
    }

    private static string GetNumberLabel(double? value)
    {
        return value is null ? "n/a" : value.Value.ToString("N0");
    }

}
