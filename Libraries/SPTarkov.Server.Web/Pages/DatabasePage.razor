@page "/database"
@using SPTarkov.Server.Web.Layout
@using SPTarkov.Server.Web.Models.Database

@layout BaseMudBlazorLayout

<div class="database-page spt-page">
<MudContainer MaxWidth="MaxWidth.False" Class="database-page-container pa-6">
    <MudStack Spacing="4">
        <MudPaper Elevation="0" Class="database-header spt-panel pa-5">
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="database-header-content">
                <MudStack Spacing="1">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="3" Class="database-title-row">
                        <MudText Typo="Typo.h3">@SelectedTable.Name</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@SelectedTable.Description</MudText>
                </MudStack>

                <MudStack Row Spacing="2" Class="database-stat-stack">
                    @foreach (var stat in SelectedTable.Stats)
                    {
                        <MudPaper Elevation="0" Class="database-stat spt-panel pa-3">
                            <MudText Typo="Typo.caption">@stat.Label</MudText>
                            <MudText Typo="Typo.h5">@stat.Value</MudText>
                        </MudPaper>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>

        <div class="database-browser-grid">
            <MudPaper Elevation="0" Class="database-sidebar spt-panel pa-4">
                <MudStack Spacing="3">
                    <MudText Typo="Typo.h6">Table</MudText>

                    <MudSelect T="string"
                               Value="@_selectedTableId"
                               ValueChanged="OnTableChanged"
                               Label="Table"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Class="database-header-table-select">
                        @foreach (var table in _tables)
                        {
                            <MudSelectItem T="string" Value="@table.Id">@table.Name</MudSelectItem>
                        }
                    </MudSelect>


                    <MudText Typo="Typo.h6">Filters</MudText>

                    <MudTextField @bind-Value="_searchText"
                                  Label="Search"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"/>

                    @foreach (var filter in SelectedTable.Filters)
                    {
                        <MudSelect T="string"
                                   Value="@GetFilterValue(filter.Id)"
                                   ValueChanged="@((value) => SetFilterValue(filter.Id, value))"
                                   Label="@filter.Label"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Dense="true">
                            <MudSelectItem T="string" Value="@AllFilterValues">@filter.AllLabel</MudSelectItem>
                            @foreach (var option in filter.Options)
                            {
                                <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
                            }
                        </MudSelect>
                    }

                    <MudDivider/>

                    <MudStack Spacing="1">
                        <MudText Typo="Typo.subtitle2">Current result</MudText>
                        <MudText Typo="Typo.h4">@FilteredRowCountLabel</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@SelectedTable.ResultLabel</MudText>
                    </MudStack>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.FilterAltOff"
                               OnClick="ClearFilters"
                               FullWidth="true">
                        Clear filters
                    </MudButton>
                </MudStack>
            </MudPaper>

            <MudPaper Elevation="0" Class="database-table-panel spt-panel pa-4">
                <MudStack Spacing="3">
                    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="database-section-toolbar">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h6">@SelectedTable.Name</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@SelectedTable.SelectionHint</MudText>
                        </MudStack>
                    </MudStack>

                    <MudTable T="DatabaseRow"
                              Items="@FilteredRows"
                              Dense="true"
                              Hover="true"
                              Bordered="false"
                              Striped="true"
                              FixedHeader="true"
                              Height="calc(100vh - 350px)"
                              Breakpoint="Breakpoint.Sm"
                              RowClassFunc="GetRowClass">
                        <HeaderContent>
                            @foreach (var column in SelectedTable.Columns)
                            {
                                <MudTh>@column.Header</MudTh>
                            }
                        </HeaderContent>
                        <RowTemplate>
                            @foreach (var column in SelectedTable.Columns)
                            {
                                <MudTd DataLabel="@column.Header">
                                    @if (column.IsPrimary)
                                    {
                                        <MudButton Variant="Variant.Text"
                                                   Color="Color.Warning"
                                                   Class="database-row-button px-0"
                                                   OnClick="@(() => SelectRow(context))">
                                            @column.GetValue(context)
                                        </MudButton>
                                    }
                                    else if (column.IsMono)
                                    {
                                        <MudText Typo="Typo.caption" Class="database-mono">@column.GetValue(context)</MudText>
                                    }
                                    else
                                    {
                                        @column.GetValue(context)
                                    }
                                </MudTd>
                            }
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" />
                        </PagerContent>
                    </MudTable>
                </MudStack>
            </MudPaper>

            <MudPaper Elevation="0" Class="database-details spt-panel pa-4">
                @if (_selectedRow is null)
                {
                    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="database-empty-details">
                        <MudIcon Icon="@Icons.Material.Filled.Dataset" Size="Size.Large" Color="Color.Secondary" />
                        <MudText Typo="Typo.h6">No record selected</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                            Pick a row from the table to view identifiers, source data, and useful properties.
                        </MudText>
                    </MudStack>
                }
                else
                {
                    <MudStack Spacing="3">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.h5">@_selectedRow.Title</MudText>
                            <MudText Typo="Typo.caption" Class="database-mono">@_selectedRow.Id</MudText>
                        </MudStack>

                        <MudStack Row Spacing="1" Class="database-chip-row">
                            @foreach (var chip in _selectedRow.Chips)
                            {
                                <MudChip T="string" Size="Size.Small" Color="@chip.Color">@chip.Text</MudChip>
                            }
                        </MudStack>

                        @foreach (var section in _selectedRow.DetailSections)
                        {
                            <MudDivider />

                            @if (!string.IsNullOrWhiteSpace(section.Title))
                            {
                                <MudText Typo="Typo.subtitle2">@section.Title</MudText>
                            }

                            <div class="database-detail-grid">
                                @foreach (var value in section.Values)
                                {
                                    @DetailValue(value.Label, value.Value, value.IsMono)
                                }
                            </div>
                        }

                        <MudDivider />

                        <MudStack Spacing="1">
                            <MudText Typo="Typo.subtitle2">Description</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@_selectedRow.Description</MudText>
                        </MudStack>

                        <MudDivider />

                        <MudStack Spacing="2" Class="database-properties">
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="database-properties-header">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.subtitle2">All item properties</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @_selectedRow.Properties.Count.ToString("N0") populated property values
                                    </MudText>
                                </MudStack>
                            </MudStack>

                            @if (_selectedRow.Properties.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">No item properties are populated for this template.</MudText>
                            }
                            else
                            {
                                <MudTable T="DatabaseProperty"
                                          Items="@_selectedRow.Properties"
                                          Dense="true"
                                          Hover="true"
                                          Bordered="false"
                                          Striped="true"
                                          FixedHeader="true"
                                          Height="320px"
                                          Class="database-properties-table">
                                    <HeaderContent>
                                        <MudTh>Property</MudTh>
                                        <MudTh>Type</MudTh>
                                        <MudTh>Value</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Property">
                                            <MudText Typo="Typo.caption" Class="database-mono database-property-path">@context.Path</MudText>
                                        </MudTd>
                                        <MudTd DataLabel="Type">@context.Kind</MudTd>
                                        <MudTd DataLabel="Value">
                                            <MudText Typo="Typo.caption" Class="database-mono database-property-value">@context.Value</MudText>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>

                                <details class="database-raw-json">
                                    <summary>Raw _props JSON</summary>
                                    <pre>@_selectedRow.PropertiesJson</pre>
                                </details>
                            }
                        </MudStack>
                    </MudStack>
                }
            </MudPaper>
        </div>
    </MudStack>
</MudContainer>
</div>
