@using System.Reflection
@using SPTarkov.Web.Components.Layout
@inject IServiceProvider ServiceProvider

<Router AppAssembly="@typeof(SPTBlazor).Assembly"
        AdditionalAssemblies="@GetModAssemblies()">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(BaseMainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>

@code {

    private Assembly[] GetModAssemblies()
    {
        // Get all registered Blazor mods and return their assemblies
        var blazorMods = ServiceProvider.GetServices<IBlazorMod>();

        /*
